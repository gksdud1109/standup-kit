#!/usr/bin/env bash
# standup — 여러 레포의 오늘 커밋을 모아 마크다운으로 출력
# usage: standup [since]      기본 오늘 05:00
#        standup "1 day ago"
set -uo pipefail

CONF="${STANDUP_HOME:-$HOME/.standup}/config"
[ -f "$CONF" ] && . "$CONF"

SINCE="${1:-${STANDUP_SINCE:-05:00}}"
IFS=':' read -ra ROOTS <<< "${STANDUP_ROOTS:-$HOME/development:$HOME/IdeaProjects}"
IFS=',' read -ra AUTHORS <<< "${STANDUP_AUTHORS:-$(git config user.email)}"

authArgs=(); for a in "${AUTHORS[@]}"; do [ -n "$a" ] && authArgs+=(--author="$a"); done
[ ${#authArgs[@]} -eq 0 ] && { echo "저자가 비었습니다. ~/.standup/config 의 STANDUP_AUTHORS 를 채우세요." >&2; exit 1; }

echo "# $(date +%F) 커밋"
echo
echo "> 기준: \`$SINCE\` 이후 · 저자: ${AUTHORS[*]}"
echo

found=0
for root in "${ROOTS[@]}"; do
  [ -d "$root" ] || continue
  while IFS= read -r gitdir; do
    repo=$(dirname "$gitdir")
    log=$(git -C "$repo" log --all --no-merges --since="$SINCE" \
          "${authArgs[@]}" --format='- `%ad` %s' --date=format:'%H:%M' 2>/dev/null | sort)
    [ -z "$log" ] && continue
    found=1
    branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
    wip=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    n=$(echo "$log" | wc -l | tr -d ' ')
    echo "## $(basename "$repo") — ${n}건 · \`$branch\` · 미커밋 ${wip}"
    echo "$log"
    echo
  done < <(find "$root" -maxdepth 3 -type d -name .git 2>/dev/null)
done
[ "$found" = "0" ] && echo "_해당 기간 커밋 없음_"
exit 0
