#!/usr/bin/env bash
# standup — 여러 레포의 오늘 커밋을 모아 마크다운으로 출력
#   standup                오늘 05:00 이후
#   standup "1 day ago"    기간 지정
#   standup --whoami       탐지된 내 git 신원 보기
set -uo pipefail

CONF="${STANDUP_HOME:-$HOME/.standup}/config"
[ -f "$CONF" ] && . "$CONF"

IFS=':' read -ra ROOTS <<< "${STANDUP_ROOTS:-$HOME/development:$HOME/IdeaProjects}"

repos() {
  local root
  for root in "${ROOTS[@]}"; do
    [ -d "$root" ] || continue
    find "$root" -maxdepth 3 -type d -name .git 2>/dev/null | while IFS= read -r g; do
      dirname "$g"
    done
  done
}

# 내 git 신원 자동 탐지: global + 각 레포의 local user.email
detect_authors() {
  { git config --global user.email 2>/dev/null
    repos | while IFS= read -r r; do
      git -C "$r" config --local user.email 2>/dev/null
    done
  } | grep -v '^$' | sort -u
}

if [ "${1:-}" = "--whoami" ]; then
  echo "탐지된 git 신원:"
  detect_authors | sed 's/^/  /'
  [ -n "${STANDUP_AUTHORS:-}" ] && echo -e "\nconfig 로 고정된 값(자동 탐지 대신 사용):\n  ${STANDUP_AUTHORS}"
  exit 0
fi

SINCE="${1:-${STANDUP_SINCE:-05:00}}"

if [ -n "${STANDUP_AUTHORS:-}" ]; then
  IFS=',' read -ra AUTHORS <<< "$STANDUP_AUTHORS"
else
  IFS=$'\n' read -rd '' -a AUTHORS < <(detect_authors; printf '\0')
fi

if [ ${#AUTHORS[@]} -eq 0 ]; then
  echo "git 신원을 찾지 못했습니다. \`git config --global user.email\` 을 설정하거나" >&2
  echo "$CONF 에 STANDUP_AUTHORS 를 직접 지정하세요." >&2
  exit 1
fi

authArgs=(); for a in "${AUTHORS[@]}"; do a="${a// /}"; [ -n "$a" ] && authArgs+=(--author="$a"); done

# 범위가 하루를 넘으면 날짜까지 찍는다 (며칠째 지연인지 판정하려면 날짜가 필요)
DATES=$(
  while IFS= read -r repo; do
    git -C "$repo" log --all --no-merges --since="$SINCE" "${authArgs[@]}" \
        --format='%ad' --date=format:'%Y-%m-%d' 2>/dev/null
  done < <(repos) | sort -u | grep -c . || true
)
if [ "${DATES:-0}" -gt 1 ]; then
  DATE_FMT='%m-%d %H:%M'
  SPAN=$(
    while IFS= read -r repo; do
      git -C "$repo" log --all --no-merges --since="$SINCE" "${authArgs[@]}" \
          --format='%ad' --date=format:'%m-%d' 2>/dev/null
    done < <(repos) | sort -u
  )
  RANGE=" · $(echo "$SPAN" | head -1) ~ $(echo "$SPAN" | tail -1)"
else
  DATE_FMT='%H:%M'
  RANGE=""
fi

echo "# $(date +%F) 커밋"
echo
echo "> 기준: \`$SINCE\` 이후${RANGE} · 저자: ${AUTHORS[*]}"
echo

found=0
while IFS= read -r repo; do
  log=$(git -C "$repo" log --all --no-merges --since="$SINCE" \
        "${authArgs[@]}" --format='- `%ad` %s' --date=format:"$DATE_FMT" 2>/dev/null | sort)
  [ -z "$log" ] && continue
  found=1
  branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
  wip=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  n=$(echo "$log" | wc -l | tr -d ' ')
  echo "## $(basename "$repo") — ${n}건 · \`$branch\`"
  echo "$log"
  if [ "$wip" -gt 0 ]; then
    files=$(git -C "$repo" status --porcelain 2>/dev/null | cut -c4- | head -12 \
            | awk 'BEGIN{ORS=""} NR>1{print " · "} {print}')
    [ "$wip" -gt 12 ] && files="$files · 외 $((wip-12))개"
    echo "- _미커밋 ${wip}: ${files}_"
  fi
  echo
done < <(repos)

[ "$found" = "0" ] && echo "_해당 기간 커밋 없음_"
exit 0
